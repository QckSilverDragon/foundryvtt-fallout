<!--Perk filter: Show All, Show Available
	Perk Sort: Alphabetical, SPECIAL
	-->
<!-- Perks List
	Perk Name
	Image	| SPECIALS 						| Ranks
			| Limitations					| Level, next lvl
			| Description					|
	-->
<section>
	<h2>{{localize 'FALLOUT.UI.Perks'}}</h2>
	<div class="flexrow">
		<div>
			<label class="field-label">
				{{localize "FALLOUT.UI.filter"}}
			</label>
			<select name="filter">
				<option value="available"
				{{#ifCond this.filter "===" "available"}}
				selected
				{{/ifCond}}
				>
				Show Available
				</option>
				<option value="all"
				{{#ifCond this.filter "===" "all"}}
					selected
				{{/ifCond}}
				>
				Show All
				</option>
			</select>
		</div>
		&nbsp;
		<div>
			<label class="field-label">
				{{localize "FALLOUT.UI.Sort"}}
			</label>
			<select name="sort">
				<option value="alphabetical">Alphabetical</option>
				<!--<option value="special">S.P.E.C.I.A.L.</option>-->
			</select>
		</div>
	</div>
	<ol class="item-list scrollable" style="list-style: none; padding-top: 10px; max-height: 75vh;">
		{{#ifCond this.filter "===" "available"}}
		{{#each availablePerks}}
		{{> apps/perk-selector/perk
			availablePerk=this
		}}
		{{/each}}
		{{/ifCond}}
		{{#ifCond this.filter "===" "all"}}
		{{#each allPerks}}
		{{> apps/perk-selector/perk
			availablePerk=this
		}}
		{{/each}}
		{{/ifCond}}
	</ol>
	<span>	</span>
</section>
